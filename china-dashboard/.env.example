# Optional. GDELT, RSS, and USGS all work with zero keys - only fill these
# in if you want the Grok or NewsAPI/TwitterAPI.io connectors too.
# Prefer not to keep keys in plaintext here? Run `python secure_setup.py`
# instead - it encrypts them AES-256-GCM into data/secrets.enc.

# xAI Grok API - https://x.ai (x_search-based live X search)
GROK_API_KEY=
# Comma-separated X handles (no @) for Grok to search, e.g.:
# GROK_TRACKED_HANDLES=CovertShores,TaiwanADIZ,PLATracker
GROK_TRACKED_HANDLES=

# TwitterAPI.io - https://twitterapi.io (cheaper raw-tweet alternative)
X_THIRDPARTY_API_KEY=

# NewsAPI.org - https://newsapi.org/register (free tier)
NEWSAPI_KEY=
